# ============================================================
# 环境变量说明：
# [必填] = env.ts 强制校验，缺失则服务启动失败
# [可选] = 有默认值或不强制，按需配置
# 生产环境请替换所有占位符，尤其是 JWT 双密钥
# ============================================================

# ---- 数据库 ----
POSTGRES_USER=monoforge_user                                          # [可选] docker-compose postgres 容器用户
# M15：密码仅用字母数字——compose 直接把密码拼进 DATABASE_URL/REDIS_URL，含 @ : / 等特殊字符会使 URL 畸形断链
POSTGRES_PASSWORD=monoforge_password                                  # [可选] docker-compose postgres 容器密码
POSTGRES_DB=monoforge_database                                        # [可选] docker-compose postgres 容器库名
DATABASE_URL=postgresql://monoforge_user:monoforge_password@localhost:5432/monoforge_database  # [必填] 后端连接串

# ---- e2e 专用 DB（独立容器 mf-e2e-postgres，DEV DB 零污染）----
E2E_DATABASE_URL=postgresql://e2e_user:e2e_password@localhost:5433/monoforge_e2e_db  # [可选] e2e 测试连接串
E2E_POSTGRES_USER=e2e_user                                            # [可选] e2e-postgres 容器用户
E2E_POSTGRES_PASSWORD=e2e_password                                    # [可选] e2e-postgres 容器密码
E2E_POSTGRES_DB=monoforge_e2e_db                                      # [可选] e2e-postgres 容器库名

# ---- Redis ----
# 本地直跑需自建 Redis 且端口映射到主机（compose 默认不映射 redis 端口，需 override）
# docker-compose 容器内：redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=your_redis_password                                    # [可选] 仅文档参考，密码已通过 REDIS_URL 传递
REDIS_URL=redis://:your_redis_password@localhost:6379                 # [必填] 必须为 redis:// 或 rediss:// 协议

# ---- JWT（必填，min 32 chars）----
# 占位符无法通过启动校验，必须替换为随机生成的真实密钥（如 openssl rand -base64 48）
# env.ts 会拒绝与示例相同的密钥，部署时务必替换
JWT_SECRET=REPLACE_ME_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS           # [必填] access token 签名密钥
JWT_REFRESH_SECRET=REPLACE_ME_WITH_RANDOM_REFRESH_SECRET_AT_LEAST_32_CHARS  # [必填] refresh token 签名密钥（不能与 JWT_SECRET 相同）

# ---- API ----
NODE_ENV=development                                                  # [可选] development | production | test
API_PORT=9000                                                         # [可选] 默认 9000
APP_NAME=MonoForge                                                    # [可选] Swagger 标题、邮件主题、邮件模板引用

# ---- 安全/代理 ----
TRUST_PROXY=false                                                     # [可选] false=不信任代理（本地直跑）；nginx/ngrok 前置时设 1
ALLOW_ORIGIN=http://localhost:3000,http://localhost:5173              # [可选] CORS 白名单，逗号分隔
COOKIE_SECURE=false                                                   # [可选] 生产必须 true；false 仅本地开发
ALLOW_INSECURE_COOKIE=false                                           # [可选] 生产 HTTP 调试逃生舱（ngrok/单容器 HTTP 调试）
ALLOW_SETUP=false                                                     # [可选] 初始化开关；example 默认 false 防照抄部署暴露 /setup/status 探测面，首次部署时临时设 true，初始化完成务必改回 false
ADMIN_ROLE_ID=1                                                       # [可选] 超级管理员 roleId，seed 默认 1

# ---- 限流 ----
THROTTLE_TTL=60                                                       # [可选] 限流窗口秒数
THROTTLE_LIMIT=10                                                     # [可选] 窗口内最大请求数

# ---- Seed（可选；首次部署 pnpm db:seed 时使用）----
SEED_ADMIN_EMAIL=admin@example.com                                    # [可选]
SEED_ADMIN_PASSWORD=888888                                            # [可选] 默认密码 888888，首登请修改
SEED_ADMIN_NICKNAME=Administrator                                     # [可选]
SEED_ADMIN_MUST_CHANGE_PASSWORD=true                                  # [可选] true=首登强制改密；false 跳过（仅本地开发，生产勿关）

# ---- 邮件（可选，不配置则邮件接口返回 400）----
MAIL_HOST=smtp.example.com                                            # [可选]
MAIL_PORT=587                                                         # [可选]
MAIL_USER=your-email@example.com                                      # [可选]
MAIL_PASSWORD=your-email-password                                     # [可选]
MAIL_FROM=noreply@example.com                                         # [可选]

# ---- 微信（可选，不配置则微信登录返回 503）----
WEAPP_APPID=your-weapp-appid                                          # [可选]
WEAPP_SECRET=your-weapp-secret                                        # [可选]
WECHAT_REDIRECT_URI=https://your-domain.com/auth/wechat/callback      # [可选]

# ---- Docker 构建（可选，仅构建镜像时需要代理才配置）----
BUILD_HTTP_PROXY=http://host.docker.internal:7897                     # [可选]

# ---- 前端 ----
VITE_API_BASE_URL=http://localhost:9000                               # [可选] 同源部署留空，跨域填后端地址
VITE_APP_NAME=MonoForge                                               # [可选] 侧边栏 Logo、页面标题
VITE_APP_SHORT_NAME=MF                                                # [可选] 短名称
VITE_ENABLE_MOCK=false                                                # [可选] true 时启用 MSW mock（仅开发环境生效）

# ---- 数据库备份（可选）----
# 定时备份开关：true=启用每日 0 点备份；false=关闭（开发环境默认关闭，避免容器未运行导致失败邮件）
# 手动触发备份不受此开关限制（POST /api/v1/schedule/backup）
ENABLE_BACKUP=false                                                     # [可选]
# 本机无 pg_dump 时用 Docker 容器内的；恢复请用 pnpm db:restore（psql 原生格式，不要用 Navicat 执行）
BACKUP_CMD=docker exec mf-postgres pg_dump -U monoforge_user monoforge_database > "{filepath}"  # [可选]
