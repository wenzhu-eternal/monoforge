# Database (required)
POSTGRES_USER=monoforge_user
POSTGRES_PASSWORD=monoforge_password
POSTGRES_DB=monoforge_database
DATABASE_URL=postgresql://monoforge_user:monoforge_password@localhost:5432/monoforge_database

# e2e 专用 DB（独立容器 mf-e2e-postgres，DEV DB 零污染）
E2E_DATABASE_URL=postgresql://e2e_user:e2e_password@localhost:5433/monoforge_e2e_db

# Redis (required)
# 本地直跑需自建 Redis 且端口映射到主机（compose 默认不映射 redis 端口，需 override）
# docker-compose 容器内：redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:your_redis_password@localhost:6379

# JWT (required, min 32 chars)
# 占位符无法通过启动校验，必须替换为随机生成的真实密钥（如 openssl rand -base64 48）
# env.ts 会拒绝与示例相同的密钥，部署时务必替换
JWT_SECRET=REPLACE_ME_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_ME_WITH_RANDOM_REFRESH_SECRET_AT_LEAST_32_CHARS

# API
NODE_ENV=development
API_PORT=9000
# 应用名（Swagger 标题、邮件主题、邮件模板均引用，新项目通过此变量配置）
APP_NAME=MonoForge

# 反向代理信任（Express trust proxy）
# false=不信任（本地直跑，防 XFF 伪造绕过 IP 限流）；nginx/ngrok 前置时设 1
TRUST_PROXY=false

# CORS
ALLOW_ORIGIN=http://localhost:3000,http://localhost:5173

# Cookie
COOKIE_SECURE=false
# 生产 HTTP 调试开关：true 时允许生产环境使用非 secure cookie（如 ngrok 调试），默认 false
ALLOW_INSECURE_COOKIE=false

# Setup（首次部署初始化开关，true 时允许调用 /api/v1/setup 接口创建管理员，初始化后建议设为 false）
ALLOW_SETUP=true

# Admin 角色判定（权限守卫超级管理员旁路用的 roleId，seed 创建的 admin 角色默认 id=1）
ADMIN_ROLE_ID=1

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Seed (optional；首次部署 pnpm db:seed 时使用，默认密码 888888 首次登录后请立即修改)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=888888
SEED_ADMIN_NICKNAME=Administrator

# Mail (optional)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@example.com

# WeApp (optional)
WEAPP_APPID=your-weapp-appid
WEAPP_SECRET=your-weapp-secret

# WeChat OAuth (optional)
WECHAT_REDIRECT_URI=https://your-domain.com/auth/wechat/callback

# Docker Build (optional; 仅构建镜像时需要代理才配置)
BUILD_HTTP_PROXY=http://host.docker.internal:7897

# Frontend
VITE_API_BASE_URL=http://localhost:9000
# 品牌名（侧边栏 Logo、页面标题等），新项目接入时修改
VITE_APP_NAME=MonoForge
VITE_APP_SHORT_NAME=MF

# Database Backup (optional; 本机无 pg_dump 时用 Docker 容器内的)
# 恢复请用 pnpm db:restore（psql 原生格式，不要用 Navicat 执行）
BACKUP_CMD=docker exec mf-postgres pg_dump -U monoforge_user monoforge_database > "{filepath}"
